---
import "../styles/paradigm.css";
---

<aside class="word-panel" id="word-panel" hidden aria-live="polite">
  <header>
    <button class="wp-back" type="button" id="wp-back" hidden title="Back to the previous word">‹ <span></span></button>
    <h2 id="wp-title"></h2>
    <button class="icon-btn" type="button" id="wp-close" aria-label="Close panel">×</button>
  </header>
  <div id="wp-body"></div>
</aside>

<style is:global>
  .word-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(26rem, 100vw);
    z-index: 40;
    background: var(--surface);
    border-left: 1px solid var(--border);
    box-shadow: -8px 0 24px rgb(0 0 0 / 0.08);
    display: flex;
    flex-direction: column;
  }
  .word-panel[hidden] {
    display: none;
  }
  .word-panel header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .word-panel h2 {
    margin: 0;
    font-weight: 500;
    font-size: 1.4rem;
    flex: 1;
    min-width: 0;
  }
  .wp-back {
    max-width: 9rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    padding: 0.15rem 0.5rem;
    font-size: 0.85rem;
    color: var(--accent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
  }
  .wp-back[hidden] {
    display: none;
  }
  .wp-back:hover {
    border-color: var(--accent);
  }
  #wp-body {
    overflow-y: auto;
    padding: 0.8rem 1rem 2rem;
    font-size: 0.95rem;
  }
  .an {
    background: var(--surface-2);
    border-radius: 8px;
    padding: 0.7rem 0.85rem;
    margin-bottom: 0.7rem;
  }
  .an .seg {
    font-style: italic;
    color: var(--muted);
    margin-bottom: 0.1rem;
  }
  .an .lemma {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .an .lemma a {
    color: inherit;
    text-decoration: none;
  }
  .an .lemma a:hover {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .word-panel {
      top: auto;
      height: 58vh;
      width: 100vw;
      border-left: 0;
      border-top: 1px solid var(--border);
      border-radius: 12px 12px 0 0;
      box-shadow: 0 -8px 24px rgb(0 0 0 / 0.15);
    }
  }
  .an .pos {
    font-style: italic;
    color: var(--muted);
  }
  .an .reading {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .an .form {
    margin: 0.15rem 0 0;
  }
  .an .props,
  .an .meta {
    font-family: var(--sans);
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 0.2rem;
  }
  .an .badge {
    font-family: var(--sans);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0 0.3rem;
    margin-left: 0.3rem;
    color: var(--muted);
    vertical-align: middle;
  }
  .dict {
    margin-top: 0.5rem;
    border-top: 1px solid var(--border);
    padding-top: 0.45rem;
  }
  .dict h4 {
    margin: 0.2rem 0;
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }
  .dict p {
    margin: 0.2rem 0;
    line-height: 1.4;
  }
  .dict details summary {
    cursor: pointer;
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--accent);
  }
  .word-panel .other-readings summary,
  .word-panel .candidate-dictionary > summary {
    cursor: pointer;
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--accent);
    margin-top: 0.4rem;
  }
  .word-panel .candidate-dictionary > summary {
    border-top: 1px solid var(--border);
    padding-top: 0.45rem;
  }
  .word-panel .candidate-dictionary .dict {
    border-top: 0;
    padding-top: 0;
  }
  .word-panel .dict-article {
    margin: 0.4rem 0 0.65rem;
    overflow-wrap: anywhere;
  }
  .word-panel .entry-headword {
    font-size: 1rem;
  }
  .word-panel .entry-section {
    margin-top: 0.35rem;
  }
  .word-panel .entry-grammar {
    color: var(--muted);
    font-size: 0.85em;
    line-height: 1.45;
  }
  .word-panel .entry-grammar strong {
    color: var(--fg);
    margin-right: 0.25rem;
  }
  .word-panel .entry-senses {
    list-style: none;
    padding: 0;
    margin: 0.3rem 0;
  }
  .word-panel .entry-senses li {
    position: relative;
    padding-left: 1.6rem;
    margin: 0.45rem 0;
    line-height: 1.4;
  }
  .word-panel .sense-number {
    position: absolute;
    left: 0;
    color: var(--faint);
    font-size: 0.85em;
    font-variant-numeric: tabular-nums;
  }
  .word-panel .sense-gloss i,
  .word-panel .homograph-gloss i {
    font-style: normal;
  }
  .word-panel .sense-examples {
    display: block;
    color: var(--muted);
    font-size: 0.87em;
    margin-top: 0.15rem;
  }
  .word-panel .headword-repeat {
    color: color-mix(in srgb, var(--accent) 65%, var(--muted));
  }
  .word-panel abbr[title] {
    text-decoration: underline dotted var(--faint);
    text-underline-offset: 0.15em;
    cursor: help;
  }
  .word-panel .other-homograph {
    border-left: 2px solid var(--border);
    padding-left: 0.5rem;
  }
  .word-panel .other-homograph > summary {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .word-panel .more-senses {
    margin: 0.4rem 0 0.6rem 1.6rem;
  }
  .word-panel .more-senses .entry-senses {
    margin-left: -1.6rem;
  }
  .word-panel .dict-via {
    color: var(--muted);
    font-size: 0.8em;
  }
  .word-panel .compound-part {
    color: var(--muted);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
  .wp-note {
    line-height: 1.5;
  }
  .wp-empty {
    color: var(--muted);
    font-style: italic;
  }
</style>
