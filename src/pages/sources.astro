---
import Base from "../layouts/Base.astro";
import Edda from "../components/sources/Edda.astro";
import { site } from "../lib/site";

const Credits = { edda: Edda }[site.id];
if (!Credits) throw new Error(`no sources page for ${site.id}`);
---

<Base title={`Sources & licences · ${site.name}`} crumbs={[{ label: "Sources & licences" }]}>
  <main class="page sources-page">
    <p class="eyebrow">Sources &amp; licences</p>
    <h1>Texts, translations and dictionaries</h1>
    <Credits />
  </main>
</Base>

<style>
  h1 {
    font-weight: 500;
    margin: 0.3rem 0 1rem;
  }
  .sources-page :global(h2) {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 2.2rem 0 0.6rem;
  }
  .sources-page :global(dt) {
    font-weight: 600;
    margin-top: 1rem;
  }
  .sources-page :global(dd) {
    margin: 0.2rem 0 0;
    color: color-mix(in srgb, var(--fg) 85%, var(--muted));
  }
</style>
