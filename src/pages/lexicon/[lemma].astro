---
import Base from "../../layouts/Base.astro";
import { decodeMsa } from "../../lib/norse";
import { base, dictionaryEntry, LEXICON, lemmaSlugs, type LemmaStat, workBySlug, WORKS } from "../../lib/site";

export function getStaticPaths() {
  return LEXICON.map((l) => ({ params: { lemma: lemmaSlugs.get(l.lemma)! }, props: { stat: l } }));
}

const { stat } = Astro.props as { stat: LemmaStat };
const dict = dictionaryEntry(stat.lemma);
const pos = decodeMsa(stat.pos).pos;
const order = new Map(WORKS.map((w, i) => [w.slug, i]));
const byWork = Object.entries(stat.works).sort((a, b) => order.get(a[0])! - order.get(b[0])!);
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const mark = (line: string) => esc(line).replace(/⟦(.*?)⟧/, "<mark>$1</mark>");
const form = (line: string) => line.match(/⟦(.*?)⟧/)?.[1] ?? "";
---

<Base
  title={`${stat.lemma}${stat.gloss ? `: ${stat.gloss}` : ""} · Old Norse lexicon · The Edda Reader`}
  description={`${stat.lemma} (${pos}) in the Eddas: ${stat.count} occurrences, dictionary entries and concordance.`}
  crumbs={[{ href: `${base}lexicon/`, label: "Lexicon" }, { label: stat.lemma }]}
>
  <main class="page">
    <p class="eyebrow">Lemma</p>
    <h1>{stat.lemma}</h1>
    <p class="meta">
      <i>{pos}</i>{stat.gloss && <> · {stat.gloss}</>} · {stat.count.toLocaleString("en")} occurrence{stat.count === 1 ? "" : "s"}
    </p>

    <section class="dict">
      {
        dict?.z?.length ? (
          <>
            <h2>Zoëga, A Concise Dictionary of Old Icelandic (1910)</h2>
            {dict.z.map((e) => (
              <p>
                <b>{e.w}</b> <span set:html={e.d.join(" ")} />
              </p>
            ))}
          </>
        ) : null
      }
      {
        dict?.w?.length ? (
          <>
            <h2>Wiktionary</h2>
            {dict.w.map((e) => (
              <p>
                <i>{e.pos}</i> {e.glosses.join("; ")}
              </p>
            ))}
          </>
        ) : null
      }
      {
        dict?.c?.length ? (
          <details>
            <summary>Cleasby–Vigfússon, An Icelandic-English Dictionary (1874)</summary>
            {dict.c.map((e) => (
              <p>
                <b>{e.w}</b> {e.d.join(" ")}
              </p>
            ))}
          </details>
        ) : null
      }
      {!dict && <p class="prose-note">No entry in Zoëga, Cleasby–Vigfússon or Wiktionary under this headword.</p>}
    </section>

    <section>
      <h2>Frequency by work</h2>
      <ul class="freq">
        {
          byWork.map(([slug, n]) => (
            <li>
              <a href={`${base}${slug}/`}>{workBySlug.get(slug)?.title}</a> <span>{n}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Concordance</h2>
      {stat.occ.length < stat.count && <p class="prose-note">Showing the first {stat.occ.length} of {stat.count}.</p>}
      <ol class="conc">
        {
          stat.occ.map(([slug, row, line, probable]) => (
            <li class={probable ? "probable" : ""}>
              <a class="ref" href={`${base}${slug}/?w=${encodeURIComponent(form(line))}#${row}`}>
                {workBySlug.get(slug)?.abbr} {row}
              </a>
              <span lang="non" set:html={mark(line)} />
              {probable ? <span class="tag" title="Not annotated by the edition; all possible analyses agree on this lemma">probable</span> : null}
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</Base>

<style>
  h1 {
    font-weight: 500;
    font-size: 2.4rem;
    margin: 0.2rem 0 0;
  }
  .meta {
    color: var(--muted);
    margin-top: 0.2rem;
  }
  h2 {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 2rem 0 0.5rem;
    font-weight: 600;
  }
  .dict p {
    margin: 0.3rem 0;
    line-height: 1.45;
  }
  .dict details summary {
    cursor: pointer;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--accent);
    margin-top: 1rem;
  }
  .freq {
    list-style: none;
    padding: 0;
    columns: 2;
    font-size: 0.95rem;
  }
  .freq span {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .freq a {
    text-decoration: none;
  }
  .conc {
    list-style: none;
    padding: 0;
  }
  .conc li {
    padding: 0.2rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }
  .conc .ref {
    display: inline-block;
    min-width: 5.5rem;
    font-family: var(--sans);
    font-size: 0.75rem;
    text-decoration: none;
  }
  .conc .tag {
    font-family: var(--sans);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    margin-left: 0.4rem;
  }
  @media (max-width: 600px) {
    .freq {
      columns: 1;
    }
  }
</style>
