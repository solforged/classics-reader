---
import Base from "../../layouts/Base.astro";
import { lang } from "../../lang";
import { parseMorph } from "../../lib/morph";
import { dictionaryHtml } from "../../lib/entry";
import {
  base, dictionaryEntry, LEXICON, lemmaSlugs, paradigms, site, type LemmaStat, workBySlug, WORKS,
} from "../../lib/site";
import "../../styles/paradigm.css";

export function getStaticPaths() {
  return LEXICON.map((l) => ({ params: { lemma: lemmaSlugs.get(l.lemma)! }, props: { stat: l } }));
}

const { stat } = Astro.props as { stat: LemmaStat };
const dict = dictionaryEntry(stat.lemma);
const parts = new Map(dict?.parts?.map((part) => [part, dictionaryEntry(part)]));
const tableSet = lang.tables;
// A folded spelling match only counts as the lemma's table when its kind fits (-at is not the noun at).
const tableKind = tableSet?.kind(stat.morph, stat.lemma);
const tables = tableSet
  ? paradigms(stat.lemma).filter((table) => table.lemma === stat.lemma || table.kind === tableKind) : [];
const pos = lang.describeMorph(stat.morph).pos;
const order = new Map(WORKS.map((w, i) => [w.slug, i]));
const byWork = Object.entries(stat.works).sort((a, b) => order.get(a[0])! - order.get(b[0])!);
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const mark = (line: string) => esc(line).replace(/⟦(.*?)⟧/, "<mark>$1</mark>");
const form = (line: string) => line.match(/⟦(.*?)⟧/)?.[1] ?? "";
---

<Base
  title={`${stat.lemma}${stat.gloss ? `: ${stat.gloss}` : ""} · ${lang.name} lexicon · ${site.name}`}
  description={`${stat.lemma} (${pos}) in ${site.corpus}: ${stat.count} occurrences, dictionary entries and concordance.`}
  crumbs={[{ href: `${base}lexicon/`, label: "Lexicon" }, { label: stat.lemma }]}
>
  <main class="page">
    <p class="eyebrow">Lemma</p>
    <h1 lang={lang.code}>{stat.lemma}</h1>
    <p class="meta">
      <i>{pos}</i>{stat.gloss && <> · {stat.gloss}</>} · {stat.count.toLocaleString("en")} occurrence{stat.count === 1 ? "" : "s"}
    </p>

    <section class="dict" set:html={dictionaryHtml(dict, {
      lemma: stat.lemma, parts, fullTitles: true, properNoun: parseMorph(stat.morph).upos === "PROPN",
    })} />

    {
      tableSet && tables.map((table, index) => (
        <section class="lemma-paradigm">
          <h2>{tableSet.heading(table.kind)}</h2>
          <div set:html={tableSet.html(table, { id: `lemma-paradigm-${index}` })} />
        </section>
      ))
    }

    <section>
      <h2>Frequency by work</h2>
      <ul class="freq">
        {
          byWork.map(([slug, n]) => (
            <li>
              <a href={`${base}${slug}/`}>{workBySlug.get(slug)?.title}</a> <span>{n}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Concordance</h2>
      {stat.occ.length < stat.count && <p class="prose-note">Showing the first {stat.occ.length} of {stat.count}.</p>}
      <ol class="conc">
        {
          stat.occ.map(([slug, row, line, probable]) => (
            <li class={probable ? "probable" : ""}>
              <a class="ref" href={`${base}${slug}/?w=${encodeURIComponent(form(line))}#${row}`}>
                {workBySlug.get(slug)?.abbr} {row}
              </a>
              <span lang={lang.code} set:html={mark(line)} />
              {probable ? <span class="tag" title="Not annotated by the edition; all possible analyses agree on this lemma">probable</span> : null}
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</Base>

<style>
  h1 {
    font-weight: 500;
    font-size: 2.4rem;
    margin: 0.2rem 0 0;
  }
  .meta {
    color: var(--muted);
    margin-top: 0.2rem;
  }
  h2,
  .dict :global(h2) {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 2rem 0 0.5rem;
    font-weight: 600;
  }
  .dict :global(p) {
    margin: 0.3rem 0;
    line-height: 1.45;
  }
  .dict :global(details > summary) {
    cursor: pointer;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--accent);
    margin-top: 1rem;
  }
  .dict :global(.dict-article) {
    margin: 0.6rem 0 1rem;
    overflow-wrap: anywhere;
  }
  .dict :global(.entry-headword) {
    font-size: 1.1rem;
  }
  .dict :global(.entry-section) {
    margin-top: 0.5rem;
  }
  .dict :global(.entry-grammar) {
    color: var(--muted);
    font-size: 0.85em;
    line-height: 1.45;
  }
  .dict :global(.entry-grammar strong) {
    color: var(--fg);
    margin-right: 0.25rem;
  }
  .dict :global(.entry-senses) {
    list-style: none;
    padding: 0;
    margin: 0.4rem 0;
  }
  .dict :global(.entry-senses li) {
    position: relative;
    padding-left: 1.8rem;
    margin: 0.6rem 0;
    line-height: 1.45;
  }
  .dict :global(.sense-number) {
    position: absolute;
    left: 0;
    color: var(--faint);
    font-size: 0.85em;
    font-variant-numeric: tabular-nums;
  }
  .dict :global(.sense-gloss i),
  .dict :global(.homograph-gloss i) {
    font-style: normal;
  }
  .dict :global(.sense-examples) {
    display: block;
    color: var(--muted);
    font-size: 0.88em;
    margin-top: 0.2rem;
  }
  .dict :global(.headword-repeat) {
    color: color-mix(in srgb, var(--accent) 65%, var(--muted));
  }
  .dict :global(abbr[title]) {
    text-decoration: underline dotted var(--faint);
    text-underline-offset: 0.15em;
    cursor: help;
  }
  .dict :global(.other-homograph) {
    border-left: 2px solid var(--border);
    padding-left: 0.7rem;
  }
  .dict :global(.other-homograph > summary) {
    color: var(--muted);
  }
  .dict :global(.more-senses) {
    margin: 0.5rem 0 0.8rem 1.8rem;
  }
  .dict :global(.more-senses > summary) {
    margin-top: 0.4rem;
  }
  .dict :global(.more-senses .entry-senses) {
    margin-left: -1.8rem;
  }
  .dict :global(.dict-via) {
    color: var(--muted);
    font-size: 0.8em;
  }
  .dict :global(.compound-part) {
    color: var(--muted);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
  .dict :global(.wp-empty) {
    color: var(--muted);
    font-style: italic;
  }
  .freq {
    list-style: none;
    padding: 0;
    columns: 2;
    font-size: 0.95rem;
  }
  .freq span {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .freq a {
    text-decoration: none;
  }
  .conc {
    list-style: none;
    padding: 0;
  }
  .conc li {
    padding: 0.2rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }
  .conc .ref {
    display: inline-block;
    min-width: 5.5rem;
    font-family: var(--sans);
    font-size: 0.75rem;
    text-decoration: none;
  }
  .conc .tag {
    font-family: var(--sans);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    margin-left: 0.4rem;
  }
  @media (max-width: 600px) {
    .freq {
      columns: 1;
    }
  }
</style>
