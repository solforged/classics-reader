---
// Works and, on a site with several collections, collection pages share the top-level slug (src/lib/site.ts checks
// that no collection id is also a work slug).
import CollectionPage from "../../components/CollectionPage.astro";
import WorkPage from "../../components/WorkPage.astro";
import { COLLECTION_PAGES, COLLECTIONS, WORKS } from "../../lib/site";

export function getStaticPaths() {
  return [
    ...WORKS.map((w) => ({ params: { slug: w.slug }, props: { kind: "work" as const } })),
    ...(COLLECTION_PAGES ? COLLECTIONS.map((c) => ({ params: { slug: c.id }, props: { kind: "collection" as const } })) : []),
  ];
}

const { slug } = Astro.params;
const { kind } = Astro.props;
---

{kind === "work" ? <WorkPage slug={slug} /> : <CollectionPage id={slug} />}
