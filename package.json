{
  "name": "eddas-reader",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "fetch": "bun scripts/run.ts fetch",
    "data": "bun scripts/run.ts build",
    "all": "bun scripts/run.ts fetch && bun scripts/run.ts build && astro build",
    "align": "bun corpora/edda/check-alignment.ts",
    "dev:gita": "READER=gita astro dev",
    "build:gita": "READER=gita astro build",
    "preview:gita": "READER=gita astro preview"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@xmldom/xmldom": "^0.9.12",
    "cheerio": "^1.2.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "astro": "7.4.2"
  }
}
