{
  "name": "eddas-reader",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "fetch": "bun scripts/fetch-sources.ts",
    "data": "bun scripts/build-data.ts",
    "all": "bun scripts/fetch-sources.ts && bun scripts/build-data.ts && astro build",
    "align": "bun scripts/check-alignment.ts",
    "dev:gita": "READER=gita astro dev",
    "build:gita": "READER=gita astro build",
    "preview:gita": "READER=gita astro preview",
    "fetch:gita": "bun scripts/gita/fetch.ts",
    "data:gita": "bun scripts/gita/build.ts",
    "all:gita": "bun scripts/gita/fetch.ts && bun scripts/gita/build.ts && READER=gita astro build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@xmldom/xmldom": "^0.9.12",
    "cheerio": "^1.2.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "astro": "7.4.2"
  }
}
