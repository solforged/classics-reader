# unit = 4-1
# book = 4
# par = 5
# speaker = FABRIZIO
# sent_id = 4-1-5-29
# text = E mi pare, secondo gli antichi esempli, che quasi tutti i capitani eccellenti, quando eglino hanno conosciuto che il nimico ha fatto forte uno lato della battaglia, non gli hanno opposta la parte più forte, ma la più debole; e l'altra più forte hanno opposta alla più debole; poi, nello appiccare la zuffa, hanno comandato alla loro parte più gagliarda, che solamente sostenga il nimico e non lo spinga, e alla più debole, che si lasci vincere e ritirisi nell'ultima schiera dell'esercito.
