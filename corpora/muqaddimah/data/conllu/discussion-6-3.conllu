# sent_id = discussion-6.55.2
# text = «كان نبي يخط فمن وافق خطه فذاك» وليس في الحديث دليل على مشروعية خط الرمل كما يزعمه بعض من لا تحصيل لديه لأن معنى الحديث كان نبي يخط فيأتيه الوحي عند ذلك الخط ولا استحالة في أن يكون ذلك عادة لبعض الأنبياء فمن وافق خطه ذلك النبي فهو ذاك أي فهو صحيح من بين الخط بما عضده من الوحي لذلك النبي الذي كانت عادته أن يأتيه الوحي عند الخط وأما إذا أخذ ذلك من الخط مجردا من غير موافقة وحي فلا وهذا معنى الحديث والله أعلم.
